<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Turing.Render\Turing.Render.csproj" />
    <ProjectReference Include="..\Turing.Sensors\Turing.Sensors.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Builtin\*.json" LogicalName="Builtin.%(Filename)%(Extension)" />
    <!-- Temas incluidos con imágenes: una carpeta por tema (Builtin/<carpeta>/theme.json + imágenes). -->
    <EmbeddedResource Include="Builtin\**\*" Exclude="Builtin\*.json" LogicalName="Builtin/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
