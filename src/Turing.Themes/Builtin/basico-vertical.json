      "y": 4,
      "w": 320,
      "h": 30,
      "text": "{time:HH:mm}",
      "size": 22,
      "bold": true,
      "align": "center"
    },
    {
      "type": "panel",
      "x": 10,
      "y": 40,
      "w": 300,
      "h": 175,
      "color": "#18233A",
      "borderColor": "#2A3A5C",
